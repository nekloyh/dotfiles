{
    "include": [
        "/home/n91ym1nhky/.config/waybar/generated/workspaces.dynamic.jsonc"
    ],

    "layer": "top",
    "position": "top",
    "margin-top": 1,
    "margin-bottom": 0,
    "margin-left": 4,
    "margin-right": 8,
    "spacing": 0,

    "modules-left": [
        "custom/launcher",
        "cpu",
        "memory",
        "temperature",
        "disk",
        "mpris",
        "hyprland/window"
    ],
    "modules-center": [
        "hyprland/submap",
        "hyprland/workspaces"
    ],
    "modules-right": [
        "custom/recording",
        "privacy",
        "group/indicators",
        "group/connectivity",
        "group/controls",
        "group/status",
        "custom/power-menu"
    ],

    "group/indicators": {
        "orientation": "horizontal",
        "modules": ["tray", "idle_inhibitor", "custom/swaync"]
    },
    "group/connectivity": {
        "orientation": "horizontal",
        "modules": ["custom/vpn", "network", "bluetooth"]
    },
    "group/controls": {
        "orientation": "horizontal",
        "modules": ["pulseaudio", "backlight", "custom/nightmode"]
    },
    "group/status": {
        "orientation": "horizontal",
        "modules": ["power-profiles-daemon", "battery", "clock"]
    },

    // ==================== CENTER MODULES ====================

    // 1..10 luôn hiện (persistent) → nút không sinh/hủy theo occupancy nên cụm
    // center không re-center, hết cảnh nhấp nháy/dịch ngang khi rời ws trống.
    "hyprland/workspaces": {
        "format": "{id}",
        "sort-by": "number",
        "persistent-workspaces": {
            "*": 10
        }
    },

    // ==================== LEFT MODULES ====================

    "custom/launcher": {
        "format": "",
        "tooltip": false,
        "on-click": "pkill walker || walker"
    },

    "cpu": {
        "format": "{usage}% 󰍛",
        "interval": 5,
        "format-alt": "{icon0}{icon1}{icon2}{icon3} {usage}% 󰍛",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "states": {
            "warning": 70,
            "critical": 90
        },
        "tooltip-format": "CPU: {usage}%\nLoad: {load}",
        "on-click-right": "$HOME/.config/hypr/scripts/waybarScripts.sh --btop"
    },

    "memory": {
        "format": "{used:0.1f}G 󰾆",
        "interval": 10,
        "format-alt": "{percentage}% 󰾆",
        "states": {
            "warning": 75,
            "critical": 90
        },
        "tooltip": true,
        "tooltip-format": "RAM {used:0.1f}G / {total:0.1f}G ({percentage}%)\nSwap {swapUsed:0.1f}G / {swapTotal:0.1f}G",
        "on-click-right": "$HOME/.config/hypr/scripts/waybarScripts.sh --btop"
    },

    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "interval": 5,
        "critical-threshold": 85,
        "format": "{temperatureC}°C {icon}",
        "format-critical": "{temperatureC}°C 󰸁",
        "format-icons": ["󱃃", "󰔏", "󱃂", "󰸁"],
        "tooltip-format": "CPU package: {temperatureC}°C",
        "on-click-right": "$HOME/.config/hypr/scripts/waybarScripts.sh --nvtop"
    },

    "disk": {
        "interval": 60,
        "path": "/",
        "format": "{percentage_used}% 󰋊",
        "states": {
            "warning": 80,
            "critical": 92
        },
        "tooltip-format": "{used} / {total} on {path} ({percentage_used}%)"
    },

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "format-stopped": "",
        "dynamic-len": 25,
        "dynamic-order": ["title", "artist"],
        "player-icons": {
            "default": "▶",
            "spotify": "󰭼",
            "firefox": "󰈹",
            "mpv": "󰐍",
            "vlc": "󰕼",
            "chromium": "󰊯",
            "google-chrome": "󰊯",
            "brave": "󱆯"
        },
        "status-icons": {
            "paused": "󰏤",
            "playing": "󰐊",
            "stopped": "󰓛"
        },
        "tooltip-format": "{player} · {status}\n{title}\n{artist} — {album}",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 30,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹 $1",
            "(.*) - Visual Studio Code": "󰨞 $1",
            "(.*) - Code - OSS": "󰨞 $1",
            "(.*) - Cursor": "󰨞 $1",
            "(.*) - Zed": "󰓻 $1",
            "(.*) — Telegram": "󰭱 $1",
            "(.*) - Discord": "󰙯 $1",
            "": "󰧵 desktop"
        },
        "separate-outputs": true,
        "icon": false
    },


    // ==================== CENTER MODULES ====================

    // Hiện tên submap đang active (vd "resize" khi ở SUPER+R mode) — tự ẩn khi không có.
    // Không có indicator này thì submap là "chế độ tàng hình": vào mode mà không biết.
    "hyprland/submap": {
        "format": "󰩨 {}",
        "always-on": false,
        "tooltip": false
    },



    // ==================== RIGHT MODULES ====================

    "custom/recording": {
        "exec": "$HOME/.config/waybar/scripts/recording.sh status",
        "return-type": "json",
        "interval": 5,
        "signal": 9,
        "format": "{}",
        "tooltip": true,
        "hide-empty-text": true,
        "on-click": "$HOME/.config/waybar/scripts/recording.sh stop"
    },

    "privacy": {
        "icon-spacing": 6,
        "icon-size": 13,
        "transition-duration": 250,
        "modules": [
            { "type": "screenshare", "tooltip": true, "tooltip-icon-size": 24 },
            { "type": "audio-in", "tooltip": true, "tooltip-icon-size": 24 }
        ]
    },

    "tray": {
        "icon-size": 14,
        "spacing": 6
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰈈",
            "deactivated": "󰈉"
        },
        "tooltip-format-activated": "Idle inhibitor: ON (chặn hypridle dim/lock)",
        "tooltip-format-deactivated": "Idle inhibitor: OFF"
    },

    "custom/swaync": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂜",
            "dnd-notification": "󰂛",
            "dnd-none": "󰪑",
            "inhibited-notification": "󱅫",
            "inhibited-none": "󰂜",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "sleep 0.1 && swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "network": {
        "format": "{ifname}",
        "format-wifi": "{icon}",
        "format-ethernet": "󰌘",
        "format-disconnected": "󰌙",
        "tooltip-format": "{ipaddr}  {bandwidthUpBits}  {bandwidthDownBits}",
        "format-linked": "󰈁 {ifname} (No IP)",
        "tooltip-format-wifi": "{essid} {icon} {signalStrength}%\n{ipaddr}\n {bandwidthUpBits}    {bandwidthDownBits}",
        "tooltip-format-ethernet": "{ifname} 󰌘\n{ipaddr}\n {bandwidthUpBits}    {bandwidthDownBits}",
        "tooltip-format-disconnected": "󰌙 Disconnected",
        "max-length": 30,
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "on-click-right": "$HOME/.config/hypr/scripts/waybarScripts.sh --nmtui"
    },

    "custom/vpn": {
        "exec": "$HOME/.config/waybar/scripts/vpn.sh status",
        "return-type": "json",
        "interval": 30,
        "signal": 8,
        "format": "{}",
        "tooltip": true,
        "on-click": "$HOME/.config/waybar/scripts/vpn.sh toggle",
        "on-click-right": "$HOME/.config/waybar/scripts/vpn.sh picker"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂳",
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format": "󰂯 {device_alias}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": " {device_alias} 󰂄{device_battery_percentage}%",
        "tooltip": true,
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-bluetooth": "{icon}",
        "format-muted": "󰖁",
        "ignored-sinks": ["Easy Effects Sink"],
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰤓",
            "headset": "󰋎",
            "phone": "󰄜",
            "portable": "󰓶",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾", "󰕾"]
        },
        "scroll-step": 5.0,
        "on-click": "$HOME/.config/hypr/scripts/volume.sh --toggle",
        "on-click-right": "pavucontrol -t 3",
        "on-scroll-up": "$HOME/.config/hypr/scripts/volume.sh --inc",
        "on-scroll-down": "$HOME/.config/hypr/scripts/volume.sh --dec",
        "tooltip-format": "{icon} {desc} | {volume}%",
        "smooth-scrolling-threshold": 1
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}",
        "format-icons": ["󰃞", "󰃝", "󰃟", "󰃠"],
        "tooltip-format": "Backlight {percent}%",
        "on-scroll-up": "$HOME/.config/hypr/scripts/brightness.sh --inc",
        "on-scroll-down": "$HOME/.config/hypr/scripts/brightness.sh --dec",
        "smooth-scrolling-threshold": 1
    },

    "custom/nightmode": {
        "exec": "$HOME/.config/waybar/scripts/nightmode.sh --waybar",
        "return-type": "json",
        "interval": 60,
        "signal": 10,
        "format": "{}",
        "tooltip": true,
        "on-click": "$HOME/.config/waybar/scripts/nightmode.sh --toggle"
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip": true,
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "format-icons": {
            "default": "󰾅",
            "performance": "󰓅",
            "balanced": "󰾅",
            "power-saver": "󰾆"
        }
    },

    "battery": {
        "design-capacity": false,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-charging": "󰂄",
        "format-plugged": "󱘖",
        "format-warning": "{icon} {capacity}%",
        "format-critical": "{icon} {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip": true,
        "tooltip-format": "{capacity}% · {time}\n{power}W",
        "on-click-right": "wlogout"
    },

    "clock": {
        "interval": 30,
        "format": " {:%H:%M}",
        "format-alt": "󰃭 {:%a %d %b · %H:%M}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            // Hex bắt buộc hardcode (Pango markup không đọc @define-color).
            // SYNC TAY với ~/.config/colors/graphite-vivid/ khi đổi palette:
            // violet #8388e8 · text #c8ccd0 · cyan #39c0b4 · orange #ea7b47 · red #ea6b62
            "format": {
                // >>> gv-mirror (regen: render-mirrors.py)
                "months":   "<span color='#8388e8'><b>{}</b></span>",
                "days":     "<span color='#c8ccd0'>{}</span>",
                "weeks":    "<span color='#39c0b4'><i>w{}</i></span>",
                "weekdays": "<span color='#ea7b47'><b>{}</b></span>",
                "today":    "<span color='#ea6b62'><b><u>{}</u></b></span>"
                // <<< gv-mirror
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "custom/power-menu": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wlogout"
    }
}
