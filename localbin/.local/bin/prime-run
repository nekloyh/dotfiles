#!/usr/bin/env bash
# prime-run — chạy một app trên dGPU NVIDIA (PRIME render offload).
#
# GHI ĐÈ /usr/bin/prime-run của gói nvidia-prime, vì bản gốc THIẾU một biến và
# do đó IM LẶNG chạy sai sau thay đổi 2026-09-01:
#
#   bản gốc:  __NV_PRIME_RENDER_OFFLOAD=1 __VK_LAYER_NV_optimus=NVIDIA_only \
#             __GLX_VENDOR_LIBRARY_NAME=nvidia "$@"
#
# Session này đặt __EGL_VENDOR_LIBRARY_FILENAMES=<chỉ mesa> để dGPU ngủ được
# (xem hypr/modules/env.lua). Biến đó kế thừa xuống mọi con, kể cả qua prime-run
# gốc → app EGL sẽ chỉ thấy EGL của Mesa → render trên Intel mà KHÔNG báo lỗi.
# Dòng __EGL_VENDOR_LIBRARY_FILENAMES dưới đây mở lại đúng đường đó cho app này.
#
# Kiểm nhanh app có thật sự chạy dGPU không:
#   prime-run glxinfo -B | grep -i 'OpenGL renderer'
#   prime-run eglinfo   | grep -i -m1 renderer
exec env \
    __NV_PRIME_RENDER_OFFLOAD=1 \
    __VK_LAYER_NV_optimus=NVIDIA_only \
    __GLX_VENDOR_LIBRARY_NAME=nvidia \
    __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json \
    "$@"
