# ── caches / logs / temp ──────────────────────────────────────────
**/cache/
**/.cache/
*.log
*.tmp
*.bak
*.old
*.swp

# ── history / session state ───────────────────────────────────────
.zsh_history
.bash_history
history
*/zsh/.zsh_sessions/
**/.zcompdump*
fish/.config/fish/fish_variables
fish/.config/fish/fish_history
fish/.config/fish/fisher_path
fcitx5/.config/fcitx5/conf/cached_layouts

# ── secrets (belt-and-suspenders — none tracked, keep it that way) ─
*token*
*secret*
*credentials*
*.key
*.pem
*.gpg
id_rsa*
id_ed25519*
.env
.env.*
.netrc

# ── Mở lại ~/.local/bin ───────────────────────────────────────────────────────
# Global ignore (~/.config/git/ignore) có dòng `bin/` để chặn thư mục build.
# Pattern không có dấu / đầu ⇒ khớp MỌI thư mục tên `bin` ở MỌI độ sâu, nên nó
# nuốt luôn `localbin/.local/bin/`. Triệu chứng cực khó thấy: `git add -A` bỏ
# qua im lặng, `git status` báo sạch, file vẫn nằm trên đĩa và stow vẫn chạy —
# chỉ máy clone mới là mất trắng.
# Phải phủ định CẢ thư mục trước rồi mới tới nội dung: git không re-include
# được file nếu thư mục cha vẫn đang bị loại.
# (Hiện KHÔNG có package nào dưới .local/bin nên chưa cần dòng phủ định. Khi
#  thêm, nhớ phủ định CẢ thư mục rồi mới tới nội dung:
#     !<pkg>/.local/bin/
#     !<pkg>/.local/bin/**
#  rồi verify: git check-ignore -v <path>  và  git ls-files <pkg>/ )
