# ── caches / logs / temp ──────────────────────────────────────────
**/cache/
**/.cache/
*.log
*.tmp
*.bak
*.old
*.swp

# ── history / session state ───────────────────────────────────────
.zsh_history
.bash_history
history
*/zsh/.zsh_sessions/
**/.zcompdump*
fish/.config/fish/fish_variables
fish/.config/fish/fish_history
fish/.config/fish/fisher_path
fcitx5/.config/fcitx5/conf/cached_layouts

# ── secrets (belt-and-suspenders — none tracked, keep it that way) ─
*token*
*secret*
*credentials*
*.key
*.pem
*.gpg
id_rsa*
id_ed25519*
.env
.env.*
.netrc
