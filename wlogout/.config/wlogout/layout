{
    "label" : "lock",
    "action" : "loginctl lock-session",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "hibernate",
    "action" : "notify-send -u critical -a wlogout 'Hibernate đã tắt' 'hibernate.target đang masked có chủ đích (lỗi resume trên hybrid GPU). Dùng Shutdown, hoặc bỏ mask: sudo systemctl unmask hibernate.target'",
    "text" : "Hibernate",
    "keybind" : "h"
}
{
    "label" : "logout",
    "action" : "loginctl terminate-user $USER",
    "text" : "Logout",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "s"
}
{
    "label" : "suspend",
    "action" : "notify-send -u critical -a wlogout 'Suspend đã tắt' 'suspend.target đang masked có chủ đích (lỗi resume trên hybrid GPU). Dùng Lock (màn vẫn sáng) hoặc Shutdown.'",
    "text" : "Suspend",
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
